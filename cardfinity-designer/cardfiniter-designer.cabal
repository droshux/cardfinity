cabal-version: 2.2
name: cardfinity-designer
version: 0.1.0.0
synopsis: UI for designing Cardfinity decks
category: Game

flag interactive
    default:
        False
    manual:
        True

common warnings
    ghc-options: -Wall

common wasm
    if arch(wasm32)
        ghc-options:
            -no-hs-main
            -optl-mexec-model=reactor
            "-optl-Wl,--export=hs_start"
        cpp-options:
            -DWASM
        if flag (interactive)
            cpp-options:
                -DINTERACTIVE

executable cardfinity-designer
    import: 
        wasm,
        warnings
    main-is:
        Main.hs
    build-depends:
      base >=4.19.2.0,
      cardfinity-core,
      ordered-containers,
      miso >=1.12.0.0,
      optics
    default-language: GHC2021
    hs-source-dirs:   
        src
    other-modules:
        Editor
        Editor.Types
        Editor.Update
        Editor.View
        Editor.Mapping
        Shared
        Theme
        Theme.CssEditor
        Theme.Selector
        Theme.Types
        CardView
        Context
